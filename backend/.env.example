DATABASE_URL=postgresql://vetclinic:vetclinic_dev@localhost:5432/vetclinic
JWT_SECRET_KEY=change-this-to-a-long-random-secret-before-deploying

# Comma-separated browser origins allowed to call the API with cookies.
# Never use * when credentials (cookies) are enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie flags — set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Access JWT lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true only when a trusted reverse proxy sets X-Forwarded-For.
LOG_LEVEL=INFO
