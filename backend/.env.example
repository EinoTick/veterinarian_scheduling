DATABASE_URL=postgresql://vetclinic:vetclinic_dev@localhost:5432/vetclinic
JWT_SECRET_KEY=change-this-to-a-long-random-secret-before-deploying

# development | production
# development: demo data is auto-seeded on first boot, /docs is served, and
#   COOKIE_SECURE=false is only a warning.
# production: seeding is skipped entirely, /docs is disabled, and the app
#   refuses to start unless COOKIE_SECURE=true.
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API with cookies.
# Never use * when credentials (cookies) are enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie flags — set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set true only when a trusted reverse proxy sets X-Forwarded-For / X-Forwarded-Proto.
# Required for docker-compose.prod.yml (edge nginx). Leave false for local uvicorn.
TRUST_PROXY=false

# Access JWT lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

LOG_LEVEL=INFO
