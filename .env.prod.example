# Production / production-compose environment template.
# Copy to .env.prod (gitignored) and replace every CHANGE_ME value.
#
#   copy .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build

# ── Database (compose-internal only; not published to the host) ───────────────
POSTGRES_DB=vetclinic
POSTGRES_USER=vetclinic
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── API ───────────────────────────────────────────────────────────────────────
# Long random secret, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_long_random_secret

# production: no demo seed, /docs disabled, COOKIE_SECURE required.
# For a local packaging smoke test with demo users, you may set
# ENVIRONMENT=development while still using COOKIE_SECURE=true behind HTTPS.
ENVIRONMENT=production

COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Public browser origin(s) that may call the API with cookies.
# Must match how users open the SPA (scheme + host + port).
CORS_ORIGINS=https://localhost

# Honor X-Forwarded-For / Proto from the edge nginx (required in this topology).
TRUST_PROXY=true

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# Login rate limiting across API replicas (optional redis service).
# RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=memory

# Empty = SPA calls same-origin /api (correct for the bundled nginx proxy).
VITE_API_BASE=

# Host ports for the edge proxy
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
