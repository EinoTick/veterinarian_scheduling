# Python virtualenvs
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# SQLite database (dev artifact)
*.db
*.db-shm
*.db-wal

# Distribution / packaging
dist/
build/
*.egg-info/

# Env files (keep committed *.example templates)
.env
.env.*
!.env.example
!.env.*.example

# TLS material generated for local/prod compose (never commit private keys)
deploy/certs/*.pem
deploy/certs/*.crt
deploy/certs/*.key
!deploy/certs/README.md

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.suo
*.sw?

# Node (root-level guard; frontend/.gitignore also covers this)
node_modules/

# Local dev scripts
start.bat
start.ps1
